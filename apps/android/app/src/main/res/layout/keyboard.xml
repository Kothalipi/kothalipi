<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/kb_bg"
    android:paddingHorizontal="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/lang_bn" android:layout_width="wrap_content" android:layout_height="36dp"
            android:background="@drawable/bg_chip" android:gravity="center" android:paddingHorizontal="16dp"
            android:text="@string/lang_bn" android:textColor="@color/key_ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/lang_en" android:layout_width="wrap_content" android:layout_height="36dp"
            android:layout_marginStart="8dp" android:background="@drawable/bg_chip" android:gravity="center"
            android:paddingHorizontal="16dp" android:text="@string/lang_en" android:textColor="@color/key_ink"
            android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:gravity="end" android:maxLines="2"
            android:paddingStart="12dp" android:textColor="@color/muted" android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="108dp">
        <View android:id="@+id/halo" android:layout_width="96dp" android:layout_height="96dp"
            android:layout_gravity="center" android:background="@drawable/bg_mic_on" android:alpha="0" />
        <ImageView android:id="@+id/mic" android:layout_width="80dp" android:layout_height="80dp"
            android:layout_gravity="center" android:background="@drawable/bg_mic" android:padding="24dp"
            android:contentDescription="@string/tap_to_speak" android:elevation="4dp" android:src="@drawable/ic_mic" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
        <ImageView android:id="@+id/key_globe" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:background="@drawable/bg_key" android:padding="12dp" android:src="@drawable/ic_globe" android:contentDescription="Switch keyboard" />
        <TextView android:id="@+id/key_comma" style="@style/KbKey" android:text="," />
        <TextView android:id="@+id/key_danda" style="@style/KbKey" android:text="।" />
        <TextView android:id="@+id/key_space" style="@style/KbKey" android:layout_weight="3" android:text="space" android:textSize="14sp" />
        <TextView android:id="@+id/key_q" style="@style/KbKey" android:text="?" />
        <TextView android:id="@+id/key_dot" style="@style/KbKey" android:text="." />
        <ImageView android:id="@+id/key_del" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_key" android:padding="12dp" android:src="@drawable/ic_backspace" android:contentDescription="Delete" />
        <ImageView android:id="@+id/key_enter" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="4dp" android:background="@drawable/bg_key" android:padding="12dp" android:src="@drawable/ic_enter" android:contentDescription="Enter" />
    </LinearLayout>
</LinearLayout>
