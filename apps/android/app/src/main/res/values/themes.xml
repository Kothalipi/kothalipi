<resources>
    <style name="Theme.Kothalipi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/kb_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="KbKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:background">@drawable/bg_key</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/key_ink</item>
        <item name="android:textSize">20sp</item>
    </style>
</resources>
